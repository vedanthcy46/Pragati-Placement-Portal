        },
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/admin/assessments/1/publish",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "admin",
            "assessments",
            "1",
            "publish"
          ]
        }
      }
    },
    {
      "name": "8. Assign Assessment to Drive",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"driveId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/admin/assessments/1/assign",
          "protocol": "http",
          "host": [
