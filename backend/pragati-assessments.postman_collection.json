        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"type\": \"MCQ\",\n    \"question_text\": \"What does MERN stand for?\",\n    \"options\": [\"A\", \"B\", \"C\", \"D\"],\n    \"correct_option\": 1,\n    \"marks\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/admin/assessments/1/questions",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "admin",
            "assessments",
            "1",
            "questions"
          ]
        }
      }
    },
