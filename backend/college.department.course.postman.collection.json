{
  "info": {
    "name": "Manage Departments & Courses",
    "description": "Covers all Department, Course, and Department Statistics endpoints for local testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiZW1haWwiOiJ0ZXN0LWFkbWluQGV4YW1wbGUuY29tIiwicm9sZSI6ImFkbWluIiwiaWF0IjoxNzgzNTk3OTc5LCJleHAiOjE3ODM2ODQzNzl9.Ro_TUXzZr4nuNYm84wUqi2K4H6oG_uqhMUQc1z9evSc" },
    { "key": "departmentId", "value": "1" },
    { "key": "courseId", "value": "1" }
  ],
  "item": [
    {
      "name": "Departments",
      "item": [
        {
          "name": "Get all departments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments"
          }
        },
        {
          "name": "Search departments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments/search?q=CSE"
          }
        },
        {
          "name": "Get department by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments/{{departmentId}}"
          }
        },
        {
          "name": "Get courses by department",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments/{{departmentId}}/courses"
          }
        },
        {
          "name": "Create department",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/departments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Engineering\",\n  \"code\": \"MECH\",\n  \"hod\": \"Dr. Vikram Singh\"\n}"
            }
          }
        },
        {
          "name": "Update department",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/departments/{{departmentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hod\": \"Dr. Updated Name\"\n}"
            }
          }
        },
        {
          "name": "Delete department",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/departments/{{departmentId}}"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get all courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses"
          }
        },
        {
          "name": "Get courses filtered by department + semester",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses?departmentId={{departmentId}}&semester=3"
          }
        },
        {
          "name": "Get course by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseName\": \"Operating Systems\",\n  \"courseCode\": \"CS302\",\n  \"semester\": 5,\n  \"credits\": 4,\n  \"departmentId\": {{departmentId}}\n}"
            }
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/courses/{{courseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credits\": 3\n}"
            }
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Department Statistics",
      "item": [
        {
          "name": "Get all department statistics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments/statistics"
          }
        },
        {
          "name": "Get statistics for one department",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/departments/statistics?departmentId={{departmentId}}"
          }
        },
        {
          "name": "Update department statistics",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/departments/statistics",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentId\": {{departmentId}},\n  \"totalStudents\": 250,\n  \"totalFaculty\": 20\n}"
            }
          }
        }
      ]
    }
  ]
}